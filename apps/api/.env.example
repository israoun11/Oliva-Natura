# Copy to apps/api/.env — never commit .env
DATABASE_URL=postgresql://oliva:oliva@localhost:5432/oliva?schema=public
# At least 32 random characters, e.g. generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
PORT=4000
# Comma-separated storefront origin(s) allowed to call the API. MUST match your storefront URL in production.
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# First admin account, created by `npm run db:seed` (password min 12 chars). Change it after first login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Cloudinary (image uploads return 503 until all three are set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=oliva-natura
UPLOAD_MAX_MB=8
