# apps/api/.env  (copy this file there)
DATABASE_URL=postgresql://oliva:oliva@localhost:5432/oliva?schema=public
JWT_SECRET=change-me-long-random-string
CORS_ORIGIN=http://localhost:3000
PORT=4000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Now-123!
# Cloudinary (required for image uploads; uploads return 503 until set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=oliva-natura
UPLOAD_MAX_MB=8
# Not integrated (need accounts): transactional email, online payment providers
# apps/storefront/.env.local
API_URL=http://localhost:4000   # server-side target for the /api proxy
